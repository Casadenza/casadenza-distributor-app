// File: prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -------------------- AUTH --------------------
model User {
  id                 String  @id @default(cuid())
  email              String  @unique
  passwordHash       String
  displayName        String?
  role               String  @default("DISTRIBUTOR") // SQLite: no enums
  forcePasswordReset Boolean @default(false)

  distributor Distributor?
  communicationMessages CommunicationMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Distributor {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name            String
  tier            String  @default("STANDARD")
  country         String?
  defaultCurrency String  @default("INR")
  phone           String?
  email           String?
  zohoAccountId   String? @unique

  // Billing
  billingName    String?
  billingLine1   String?
  billingLine2   String?
  billingCity    String?
  billingState   String?
  billingZip     String?
  billingCountry String?

  tickets Ticket[]
  orders  Order[]
  communicationThreads CommunicationThread[]
  rewardsWallet PartnerRewardsWallet?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// -------------------- PRODUCTS --------------------
model Product {
  id          String  @id @default(cuid())
  sku         String  @unique
  name        String
  image       String?
  collection  String?
  stoneType   String?
  thicknessMm Float?
  isActive    Boolean @default(true)

  // NEW ARRIVALS
  galleryJson         String?
  isNewArrival        Boolean @default(false)
  newArrivalPriority  Int     @default(0)

  variants   ProductVariant[]
  orderItems OrderItem[] // opposite relation for OrderItem.product

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sizeLabel String
  widthMm   Float?
  heightMm  Float?
  isActive  Boolean @default(true)

  prices Price[]

  // Opposite relation for OrderItem.variant
  orderItems OrderItem[]

  // ✅ Packing Rules (NEW)
  packingRules PackingRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([productId, sizeLabel], name: "productId_sizeLabel")
  @@index([productId])
}

model Price {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  tier     String
  currency String

  priceSheet Float?
  priceSqm   Float?
  priceSqft  Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([variantId, tier, currency], name: "variantId_tier_currency")
  @@index([variantId])
}

// -------------------- OTHER TABLES --------------------
model Announcement {
  id       String  @id @default(cuid())
  title    String
  message  String
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Ticket {
  id            String      @id @default(cuid())
  distributorId String
  distributor   Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  type        String
  subject     String
  description String
  status      String @default("OPEN")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([distributorId])
  @@index([createdAt])
}

// -------------------- ORDERS --------------------
model Order {
  id            String      @id @default(cuid())
  distributorId String
  distributor   Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  status String  @default("RECEIVED")
  eta    String?
  notes  String?
  emailNotificationState String @default("NOT_SENT")
  emailNotificationRequestedAt DateTime?
  emailNotificationAdminSentAt DateTime?
  emailNotificationDistributorSentAt DateTime?

  items     OrderItem[]
  documents OrderDocument[]
  communicationThreads CommunicationThread[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([distributorId])
  @@index([createdAt])
}

model OrderItem {
  id String @id @default(cuid())

  orderId   String
  productId String?
  variantId String?

  qty       Int
  unitPrice Float

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  product Product? @relation(fields: [productId], references: [id], onDelete: Restrict)

  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model OrderDocument {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  title String?
  url   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([orderId])
}

// -------------------- PACKING CALCULATOR --------------------
model PackingRule {
  id String @id @default(cuid())

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  packingType String

  sheetsPerUnit    Int
  weightPerSheetKg Float

  unitLengthCm Float
  unitWidthCm  Float
  unitHeightCm Float

  unitTareKg Float

  palletUnitsPerPallet Int?
  palletLengthCm       Float?
  palletWidthCm        Float?
  palletHeightCm       Float?
  palletTareKg         Float?

  fragile         Boolean @default(false)
  stackingAllowed Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([variantId, packingType])
  @@index([variantId])
}

model ContainerType {
  id String @id @default(cuid())

  mode String

  volumeCbm   Float
  maxWeightKg Float

  internalLengthCm Float
  internalWidthCm  Float
  internalHeightCm Float

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([mode])
}

model SheetWeightMaster {
  id               String   @id @default(cuid())
  collection       String
  stoneType        String
  sizeLabel        String
  perSheetWeightKg Float
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([collection, stoneType, sizeLabel], name: "collection_stoneType_sizeLabel")
  @@index([collection, stoneType, sizeLabel])
}

model PackingRuleMaster {
  id              String   @id @default(cuid())
  packingType     String
  sizeLabel       String
  qtyMin          Int
  qtyMax          Int
  dimLIn          Float
  dimWIn          Float
  dimHIn          Float
  packingWeightKg Float
  isDefault       Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([packingType, sizeLabel])
  @@index([packingType, sizeLabel, qtyMin, qtyMax])
}

model MarketingAsset {
  id           String   @id @default(cuid())
  title        String

  type         String
  category     String

  collection   String?
  stoneType    String?
  description  String?

  fileUrl      String?
  externalUrl  String?
  filePath     String?
  mimeType     String?
  fileSize     Int?

  thumbnailUrl String?

  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([type])
  @@index([category])
  @@index([isActive])
}

// -------------------- DISTRIBUTOR COMMUNICATIONS --------------------
model CommunicationThread {
  id            String      @id @default(cuid())
  distributorId String
  distributor   Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  orderId       String?
  order         Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  subject       String
  category      String      @default("GENERAL")
  status        String      @default("OPEN")
  messages      CommunicationMessage[]
  lastMessageAt DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([distributorId, lastMessageAt])
  @@index([orderId])
}

model CommunicationMessage {
  id                  String              @id @default(cuid())
  threadId            String
  thread              CommunicationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderUserId        String?
  sender              User?               @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
  senderRole          String
  body                String
  readByAdminAt       DateTime?
  readByDistributorAt DateTime?
  notificationStatus  String              @default("PENDING")
  notificationSentAt  DateTime?
  notificationError   String?
  createdAt           DateTime            @default(now())

  @@index([threadId, createdAt])
  @@index([senderUserId])
}


// -------------------- PARTNER REWARDS (PENDING MIGRATION) --------------------
// Points are non-expiring. Wallet balance is always updated with ledger entries
// in the same transaction. Only verified invoices and approved submissions earn.
model PartnerRewardsWallet {
  distributorId String @id
  distributor   Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  balance       Int @default(0)
  lifetimeEarned Int @default(0)
  lifetimeRedeemed Int @default(0)
  ledger        PartnerRewardLedger[]
  submissions   PartnerRewardSubmission[]
  redemptions   PartnerRewardRedemption[]
  sales         PartnerRewardSale[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PartnerRewardLedger {
  id            String @id @default(cuid())
  distributorId String
  wallet        PartnerRewardsWallet @relation(fields: [distributorId], references: [distributorId], onDelete: Cascade)
  kind          String
  points        Int
  sourceKey     String @unique
  description   String
  createdAt     DateTime @default(now())

  @@index([distributorId, createdAt])
}

model PartnerRewardSubmission {
  id               String @id @default(cuid())
  distributorId    String
  wallet           PartnerRewardsWallet @relation(fields: [distributorId], references: [distributorId], onDelete: Cascade)
  type             String
  reference        String
  description      String
  evidenceUrl      String?
  marketingConsent Boolean @default(false)
  status           String @default("PENDING")
  awardedPoints    Int @default(0)
  reviewNote       String?
  reviewedAt       DateTime?
  createdAt        DateTime @default(now())

  @@unique([distributorId, type, reference])
  @@index([status, createdAt])
}

model PartnerRewardRedemption {
  id              String @id @default(cuid())
  distributorId   String
  wallet          PartnerRewardsWallet @relation(fields: [distributorId], references: [distributorId], onDelete: Cascade)
  type            String
  points          Int
  orderId         String?
  notes           String
  status          String @default("REQUESTED")
  reviewerNote    String?
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())

  @@index([distributorId, status, createdAt])
  @@index([status, createdAt])
}

model PartnerRewardSale {
  id              String @id @default(cuid())
  distributorId   String
  wallet          PartnerRewardsWallet @relation(fields: [distributorId], references: [distributorId], onDelete: Cascade)
  invoiceId       String
  invoiceDate     DateTime
  currency        String
  netAmountCents  Int
  pointsAwarded   Int
  verifiedBy      String
  createdAt       DateTime @default(now())

  @@unique([distributorId, invoiceId])
  @@index([distributorId, invoiceDate])
}


// -------------------- AUTOMATED ORDER & SHIPMENT INBOX --------------------
// Independent of customer-visible order documents; receiving an email never
// creates an order or exposes an attachment to a distributor.
model OperationsInboxItem {
  id                       String   @id @default(cuid())
  mailbox                  String
  messageId                String
  partId                   String
  filename                 String?
  sender                   String
  subject                  String
  snippet                  String?
  receivedAt               DateTime?
  kind                     String
  matchState               String   @default("NEEDS_REVIEW")
  reviewStatus             String   @default("PENDING")
  suggestedOrderId         String?
  suggestedDistributorId   String?
  matchReason              String
  attachedOrderId          String?
  attachedDocumentId       String?
  reviewedBy               String?
  reviewedAt               DateTime?
  firstSeenAt              DateTime @default(now())
  lastSeenAt               DateTime @updatedAt

  @@unique([mailbox, messageId, partId])
  @@index([reviewStatus, receivedAt])
  @@index([suggestedDistributorId, reviewStatus])
  @@index([receivedAt])
}

model OperationsInboxScanRun {
  id              String   @id @default(cuid())
  scheduledSlot   String   @unique
  status          String   @default("RUNNING")
  infoStatus      String   @default("PENDING")
  alexStatus      String   @default("PENDING")
  messagesScanned Int      @default(0)
  itemsAdded      Int      @default(0)
  errorSummary    String?
  startedAt       DateTime @default(now())
  completedAt     DateTime?

  @@index([startedAt])
}


// Gmail credentials are encrypted with a server-only key before storage.
// Never expose token values through admin endpoints or distributor views.
model GmailMailboxConnection {
  mailbox               String   @id
  address               String
  encryptedRefreshToken String   @db.Text
  connectedBy           String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
